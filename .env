# Скопируйте в .env и замените ВСЕ значения "change-me". Файл .env в git не попадает.
#   Linux/macOS: cp .env.example .env      Windows: copy .env.example .env

# --- PostgreSQL (контейнер db) ---
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=123456
POSTGRES_DB=restaurant

# --- Секреты JWT (в production: случайные строки от 32 символов, например `openssl rand -hex 32`) ---
JWT_SECRET=1f76ba53755addb4470c4561c638592d942ab95c75c22a0d5a70dba031ee0863
REFRESH_SECRET=d363ea745847d4ddefc45938021ee39000ca00d5ec4db8236e0f5769d2677bc0
ACCESS_TOKEN_TTL=45m
REFRESH_TOKEN_TTL=1d

# --- Режим и сеть ---
NODE_ENV=development
WEB_PORT=8080
API_PORT=3001
# Заполнить БД тестовыми данными при первом запуске (только development; в production оставьте false)
RUN_SEED=true
RESTAURANT_TZ=Europe/Moscow
# Разрешённые Origin для CORS через запятую (за nginx из docker compose не нужно)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Запуск БЕЗ Docker (npm run dev:all) ---
DATABASE_URL=postgres://restaurant:123456@localhost:5432/restaurant
# Только для интеграционных тестов; имя базы ОБЯЗАТЕЛЬНО заканчивается на _test
TEST_DATABASE_URL=postgres://restaurant:123456@localhost:5432/restaurant_test
